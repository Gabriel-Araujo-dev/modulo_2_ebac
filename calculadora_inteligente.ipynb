      "cell_type": "code",
      "source": [
        "# ==========================================\n",
        "#           CALCULADORA EM PYTHON\n",
        "# ==========================================\n",
        "\n",
        "print(\"===== CALCULADORA =====\")\n",
        "\n",
        "# O programa continuará executando até que o usuário escolha sair.\n",
        "while True:\n",
        "\n",
        "    # Exibe o menu de operações disponíveis.\n",
        "    print(\"\\nEscolha uma operação:\")\n",
        "    print(\"1 - Adição\")\n",
        "    print(\"2 - Subtração\")\n",
        "    print(\"3 - Multiplicação\")\n",
        "    print(\"4 - Divisão\")\n",
        "    print(\"5 - Sair\")\n",
        "\n",
        "    # Recebe a opção escolhida pelo usuário.\n",
        "    opcao = input(\"Digite a opção desejada: \")\n",
        "\n",
        "    # Encerra o programa caso o usuário escolha a opção 5.\n",
        "    if opcao == \"5\":\n",
        "        print(\"\\nCalculadora encerrada. Até mais!\")\n",
        "        break\n",
        "\n",
        "    # Verifica se a opção informada é válida.\n",
        "    if opcao not in [\"1\", \"2\", \"3\", \"4\"]:\n",
        "        print(\"\\nOpção inválida! Tente novamente.\")\n",
        "        continue\n",
        "\n",
        "    # Recebe os dois números e converte os valores para float.\n",
        "    numero1 = float(input(\"Digite o primeiro número: \"))\n",
        "    numero2 = float(input(\"Digite o segundo número: \"))\n",
        "\n",
        "    # Realiza a operação escolhida pelo usuário.\n",
        "    if opcao == \"1\":\n",
        "        resultado = numero1 + numero2\n",
        "        simbolo = \"+\"\n",
        "\n",
        "    elif opcao == \"2\":\n",
        "        resultado = numero1 - numero2\n",
        "        simbolo = \"-\"\n",
        "\n",
        "    elif opcao == \"3\":\n",
        "        resultado = numero1 * numero2\n",
        "        simbolo = \"×\"\n",
        "\n",
        "    elif opcao == \"4\":\n",
        "\n",
        "        # Evita uma divisão por zero.\n",
        "        if numero2 == 0:\n",
        "            print(\"\\nErro: não é possível dividir por zero.\")\n",
        "            continue\n",
        "\n",
        "        resultado = numero1 / numero2\n",
        "        simbolo = \"÷\"\n",
        "\n",
        "    # Exibe a operação e o resultado para o usuário.\n",
        "    print(f\"\\nResultado: {numero1} {simbolo} {numero2} = {resultado}\")"
      ],
